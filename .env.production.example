# Copy values into the host's private environment settings. No actual secrets here.
PUBLIC_URL=https://YOUR-SITE.example.com
COOKIE_SECURE=true
DEBUG=false
AUTH_REQUIRED=true

# Mount a persistent volume at /data for the single-container image.
DATABASE_URL=sqlite:////data/documind.db
UPLOAD_DIR=/data/uploads
CHROMA_PERSIST_DIR=/data/chroma_db
HF_HOME=/data/huggingface

# Use your existing provider, key, and model. Gemini uses OPENAI_API_KEY here.
LLM_BACKEND=gemini
OPENAI_MODEL=YOUR_GEMINI_MODEL
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Gmail requires an App Password, not the account's usual login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

PROCESSING_WORKER_ENABLED=true
PRELOAD_EMBEDDINGS=true
EMBEDDING_CPU_THREADS=2
ENABLE_RERANKING=false
