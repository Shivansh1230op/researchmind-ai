# Same-origin proxy. Server-side build variable for Docker/Vercel/Netlify builds.
# On Netlify, replace localhost with the hosted Python backend's HTTPS origin
# (no trailing slash or /api suffix), then trigger a new build.
API_PROXY_URL=http://127.0.0.1:8000
# Prefer the same-origin proxy for cookie authentication.
# NEXT_PUBLIC_API_URL=/api
