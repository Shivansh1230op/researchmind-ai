# ── Application Settings ──────────────────────────────────────
APP_NAME=ResearchMind AI
APP_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ── OpenAI API ────────────────────────────────────────────────
# Required for LLM-based RAG. Get your key from https://platform.openai.com/api-keys
# For OpenRouter: set OPENAI_BASE_URL=https://openrouter.ai/api/v1 and OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2048

# ── LLM Backend ──────────────────────────────────────────────
# openai, ollama, gemini, or local (Hugging Face)
LLM_BACKEND=openai
LOCAL_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.2

# ── Embeddings ────────────────────────────────────────────────
# Uses Sentence Transformers (local, no API key needed)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ── Vector Store ─────────────────────────────────────────────
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=documind_collection

# ── Text Processing ──────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,md

# ── Retrieval ─────────────────────────────────────────────────
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.3
ENABLE_RERANKING=True
ENABLE_HYBRID_SEARCH=True
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/documind.db

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── File Paths ───────────────────────────────────────────────
UPLOAD_DIR=data/uploads
SAMPLE_DOCS_DIR=data/sample_documents

# ── Conversation Memory ──────────────────────────────────────
MAX_CONVERSATION_HISTORY=10
# ResearchMind workspace and session settings
AUTH_REQUIRED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
PROCESSING_WORKER_ENABLED=true
PRELOAD_EMBEDDINGS=true
EMBEDDING_CPU_THREADS=4
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
# For free local generation, set LLM_BACKEND=ollama below.

