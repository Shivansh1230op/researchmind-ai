# Enter these in Vercel Project Settings > Environment Variables.
# Connect a PostgreSQL database from Storage/Marketplace, with pgvector support.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Create a PRIVATE Blob store and include its read-write-token environment variable.
BLOB_READ_WRITE_TOKEN=
INTERNAL_WORKER_SECRET=

# Existing generation provider settings (Gemini also supplies cloud embeddings).
LLM_BACKEND=gemini
OPENAI_MODEL=YOUR_GEMINI_MODEL
OPENAI_API_KEY=
REMOTE_EMBEDDING_MODEL=gemini-embedding-001
# Optional separate Gemini key if generation uses another provider.
EMBEDDING_API_KEY=

# Gmail App Password; never use your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Set this when attaching a custom domain. Vercel domains are allowed automatically.
# PUBLIC_URL=https://research.example.com
# Vercel entrypoints automatically select cloud adapters and secure cookies.
